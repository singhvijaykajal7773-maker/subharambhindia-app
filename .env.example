# REQUIRED
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_PHONE=replace-with-owner-phone
OWNER_USERNAME=replace-with-owner-username
OWNER_EMAIL=owner@example.com

# PRODUCTION DATABASE (Render PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PG_POOL_MAX=5
# Set true only if your Postgres provider does not require SSL
PGSSL_DISABLE=false

# AUTH / OTP
NODE_ENV=production
DEMO_MODE=false
# Production must have an OTP delivery endpoint that accepts { phone, otp }
OTP_WEBHOOK_URL=https://your-otp-provider.example/send

# Web / PWA
APP_BASE_URL=https://your-app.onrender.com
CORS_ORIGIN=https://your-app.onrender.com

# AI messaging (server-side; never expose keys in browser)
AI_MESSAGE_API_URL=https://api.openai.com/v1/chat/completions
AI_MESSAGE_API_KEY=
AI_MESSAGE_MODEL=gpt-4o-mini

# Optional AI voice providers
AI_CALL_PROVIDER=
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
BOLNA_API_KEY=
BLAND_API_KEY=
BLAND_VOICE_ID=maya
BLAND_LANGUAGE=hi

# WebRTC calling. TURN is strongly recommended for mobile/carrier/NAT networks.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
